.organization-details-page {
  width: 100%;
  padding: 28px;
  direction: rtl;
  box-sizing: border-box;
}

.organization-details-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.organization-back-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 0;
  background: transparent;
  cursor: pointer;
  font: inherit;
}

.organization-current-role {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 11px;
  border-radius: 999px;
  background: #f3f4f6;
  font-size: 13px;
  font-weight: 600;
}

.organization-details-hero {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 22px;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  background: #ffffff;
}

.organization-hero-icon {
  width: 58px;
  height: 58px;
  flex: 0 0 58px;
  border-radius: 13px;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.organization-hero-content {
  flex: 1;
}

.organization-hero-content h2 {
  margin: 0 0 7px;
  font-size: 23px;
}

.organization-hero-content p {
  margin: 0;
  color: #6b7280;
  line-height: 1.8;
  font-size: 14px;
}

.organization-hero-meta {
  display: flex;
  flex-direction: column;
  gap: 9px;
  font-size: 13px;
  color: #6b7280;
}

.organization-hero-meta span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.organization-tabs {
  display: flex;
  gap: 8px;
  margin: 20px 0;
  border-bottom: 1px solid #e5e7eb;
}

.organization-tab {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 0;
  border-bottom: 2px solid transparent;
  padding: 11px 15px;
  background: transparent;
  cursor: pointer;
  font: inherit;
  color: #6b7280;
}

.organization-tab.active {
  color: #111827;
  border-bottom-color: #111827;
  font-weight: 600;
}

.organization-members-layout {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    minmax(290px, 350px);
  gap: 20px;
  align-items: start;
}

.organization-members-card,
.organization-add-member-card {
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
}

.organization-section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 16px;
  border-bottom: 1px solid #e5e7eb;
}

.organization-section-header h3 {
  margin: 0 0 6px;
  font-size: 17px;
}

.organization-section-header p {
  margin: 0;
  color: #6b7280;
  font-size: 13px;
}

.organization-member-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 15px;
}

.organization-member-item {
  display: grid;
  grid-template-columns:
    42px
    minmax(0, 1fr)
    auto
    36px;
  gap: 12px;
  align-items: center;
  padding: 13px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}

.organization-member-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  font-weight: 700;
}

.organization-member-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.organization-member-info strong {
  font-size: 14px;
}

.organization-member-info span {
  direction: ltr;
  text-align: right;
  color: #6b7280;
  font-size: 12px;
}

.organization-member-role select,
.organization-selected-user select {
  border: 1px solid #d1d5db;
  border-radius: 8px;
  padding: 8px 10px;
  background: #ffffff;
  font: inherit;
  font-size: 12px;
}

.organization-owner-badge,
.organization-role-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 9px;
  border-radius: 8px;
  background: #f3f4f6;
  font-size: 12px;
  white-space: nowrap;
}

.organization-remove-member {
  width: 34px;
  height: 34px;
  border: 1px solid #fecaca;
  border-radius: 8px;
  background: #ffffff;
  color: #b91c1c;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.organization-member-search {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 16px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  padding: 0 11px;
}

.organization-member-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  padding: 11px 0;
  font: inherit;
}

.organization-search-results {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 10px;
}

.organization-search-user {
  width: 100%;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  background: #ffffff;
  padding: 10px;
  cursor: pointer;
  text-align: right;
  font: inherit;
}

.organization-search-user.selected {
  border-color: #4b5563;
  background: #f9fafb;
}

.organization-search-user div,
.organization-selected-user > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.organization-search-user strong,
.organization-selected-user strong {
  font-size: 13px;
}

.organization-search-user span,
.organization-selected-user span {
  direction: ltr;
  text-align: right;
  color: #6b7280;
  font-size: 12px;
}

.organization-no-result {
  padding: 12px;
  text-align: center;
  color: #6b7280;
  font-size: 13px;
}

.organization-selected-user {
  margin-top: 14px;
  padding: 14px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.organization-selected-user label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
}

.organization-selected-user button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 0;
  border-radius: 9px;
  padding: 10px 12px;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
}

.organization-mock-note {
  margin-top: 15px;
  padding: 10px;
  background: #f9fafb;
  border-radius: 8px;
  color: #6b7280;
  font-size: 11px;
  line-height: 1.8;
}

.organization-permission-message {
  margin-top: 16px;
  padding: 13px;
  border-radius: 9px;
  background: #f9fafb;
  color: #6b7280;
  font-size: 13px;
  line-height: 1.8;
}

.organization-projects-placeholder {
  min-height: 280px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 10px;
  padding: 24px;
}

.organization-projects-placeholder h3 {
  margin: 7px 0 0;
}

.organization-projects-placeholder p {
  margin: 0;
  color: #6b7280;
}

.organization-projects-placeholder span {
  margin-top: 8px;
  padding: 8px 11px;
  border-radius: 8px;
  background: #f3f4f6;
  font-size: 12px;
}

.organization-details-state {
  min-height: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.organization-details-state button {
  border: 1px solid #d1d5db;
  background: #ffffff;
  border-radius: 8px;
  padding: 9px 14px;
  cursor: pointer;
  font: inherit;
}

@media (max-width: 980px) {
  .organization-members-layout {
    grid-template-columns: 1fr;
  }

  .organization-details-hero {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .organization-hero-meta {
    width: 100%;
    padding-right: 74px;
  }
}

@media (max-width: 650px) {
  .organization-details-page {
    padding: 18px;
  }

  .organization-member-item {
    grid-template-columns:
      40px
      minmax(0, 1fr);
  }

  .organization-member-role {
    grid-column: 2;
  }

  .organization-remove-member {
    grid-column: 2;
  }

  .organization-hero-meta {
    padding-right: 0;
  }
}
